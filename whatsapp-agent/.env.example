# AgentKit — Variables de entorno (All Import)
# Copiá este archivo a .env y completá los valores reales. .env NUNCA se sube a git.

# Anthropic — obtenela en platform.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Proveedor de WhatsApp — este proyecto sólo generó el adaptador Twilio
WHATSAPP_PROVIDER=twilio

# Twilio — Console (Account SID / Auth Token) + Messaging > Try it out > WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Servidor
PORT=8000
ENVIRONMENT=development

# Base de datos
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
