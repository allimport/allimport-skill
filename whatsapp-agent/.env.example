# AgentKit — Variables de entorno (All Import)
# Copiá este archivo a .env y completá los valores reales. .env NUNCA se sube a git.

# Google Gemini (capa gratuita) — obtenela en aistudio.google.com/apikey
GEMINI_API_KEY=

# Proveedor de WhatsApp — este proyecto sólo generó el adaptador Twilio
WHATSAPP_PROVIDER=twilio

# Twilio — Console (Account SID / Auth Token) + Messaging > Try it out > WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Tu propio WhatsApp (con código de país, sin espacios ni "+") — a donde el
# bot te avisa cuando escala_a_humano se activa
OWNER_WHATSAPP_NUMBER=

# Token secreto propio (inventá cualquier texto largo) para /clientes.csv —
# sin esto configurado, el export de clientes queda deshabilitado
ADMIN_TOKEN=

# Servidor
PORT=8000
ENVIRONMENT=development

# Base de datos — sqlite local (se borra en cada redeploy de Render Free) o
# postgresql://... de un proyecto Supabase gratis (persiste de verdad)
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
